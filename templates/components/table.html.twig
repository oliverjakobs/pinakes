<div hx-table-content class="table-container">

<table class="list">
  <thead>
    <tr>
    {% for caption in table.captions %}
      <th
        {% if caption.order_by is not empty %}
          hx-get="{{ filter_url(app.request, table.filter|merge({
            'order_by': caption.order_by,
            'order_dir': (caption.order_dir == 'asc') ? 'desc' : 'asc',
            'page': 1
          })) }}"
          hx-trigger="click"
          hx-swap="outerHTML"
          hx-target="[hx-table-content]"
          class="can-order"
        {% endif %}
      >
        {% if caption.text is defined %}
          <div class="caption {{ caption.order_dir }}">{{ caption.text }}</div>
        {% endif %}
      </th>
    {% endfor %}
    </tr>
  </thead>
  <tbody>
  {% for entity in table.currentPage %}
    <tr>
    {% for field in table.columns %}
      {{ render_value(field, entity) | raw }}
    {% endfor %}
    </tr>
  {% else %}
    <tr class="empty">
      <td colspan="{{ table.columns|length }}">Nothing found!</td>
    </tr>
  {% endfor %}
  </tbody>
</table>

{% if table.allow_pagination %}
  {% include 'elements/pagination.html.twig' with {
    'page': table.page,
    'per_page': table.perPage,
    'count': table.count,
    'filter': table.filter
  } only %}
{% endif %}

</div>
