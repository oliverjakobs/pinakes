<div hx-table-content class="table-container">
<div class="tiled">
  {% for entity in data|slice((filter.page - 1) * filter.pp, filter.pp) %}
    <div class="card">
      <div class="icon">{{ icon(entity.icon)}}</div>
      <div class="caption">{{ entity.caption }}</div>
    </div>
  {% else %}
    <p>Nothing found!</p>
  {% endfor %}
</div>

{% if allow_pagination ?? true %}
  {% include 'elements/pagination.html.twig' with {
    'page': filter.page,
    'count': data|length,
    'per_page': filter.pp,
    'filter': filter
  } only %}
{% endif %}

</div>
